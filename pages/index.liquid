<div class="splash stack">
  <h1 class="logo logo--home | font-display font-bold no-underline">
    Evan
    <span class="logo__sub">Harrison</span>
  </h1>
  <div class="splash__body | stack">
    <p class="splash__text">
      Personal website of the aforementioned.<br>
      Web development + other things.
    </p>
    {% render 'socials', socials: socials %}

    <ul class="splash__list | stack">
      {% assign nav = collections.all | eleventyNavigation %}
      {%- for page in nav -%}
        <li class="splash__list-item button button--partial-border">
          {% assign info = collections.all | find: 'fileSlug', page.key %}
          <a class="splash__list-item-link | no-underline" href="{{ page.key }}">
            {{- page.title }}
            <div>{{ info.data.description }}</div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
